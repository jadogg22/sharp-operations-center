# DATA_MODE selects the data source:
#   demo       (default) seeded SQLite database with fictional data.
#              A fresh clone runs with no configuration at all.
#   production read-only Mcloud SQL Server. Requires the SQL_* settings below
#              and the local sql/ query pack (see sql/README.md).
DATA_MODE=demo
DEMO_DATABASE_PATH=data/sharp_demo.sqlite3

# Production data source. Keep real credentials in your local .env only —
# never commit it. SQL_DATABASE also accepts the legacy SQL_DB name from
# go-sharpGraphs/.env, which you can reuse without copying it:
#   SHARP_OPERATIONS_ENV_FILE=../go-sharpGraphs/.env
# SQL_SERVER=
# SQL_PORT=1433
# SQL_DATABASE=
# SQL_USER=
# SQL_PASSWORD=
# Fleet cost report GL accounts (comma-separated "ACCOUNT:Label" pairs):
# FLEET_COST_CATEGORIES=51601000:Fleet lease

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
